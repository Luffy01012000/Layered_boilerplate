{
  "trailingComma": "none",
  "tabWidth": 2,
  "semi": false,
  "singleQuote": true,
  "bracketSameLine": true,
  "singleAttributePerLine": true,
  "endOfLine": "lf",
  "arrowParens": "always",
  "bracketSpacing": true,
  "useTabs": false,
  "printWidth": 80,
  "quoteProps": "consistent",
  "proseWrap": "preserve",
  "embeddedLanguageFormatting": "auto",
  "htmlWhitespaceSensitivity": "strict"
}
