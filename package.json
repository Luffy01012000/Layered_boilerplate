{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "start": "bun run build && node dist/server.js",
    "build": "cross-env NODE_ENV=production tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "dev": "cross-env NODE_ENV=development  tsx watch src/server.ts",
    "lint": "tsc --noEmit && eslint \"src/**/*.ts\"",
    "lint:fix": "tsc --noEmit && eslint \"src/**/*.ts\" --fix",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepare": "husky",
    "prisma:generate": "bun x prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "@types/source-map-support": "^0.5.10",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "colorette": "^2.0.20",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "dotenv-flow": "^4.1.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "pg": "^8.21.0",
    "source-map-support": "^0.5.21",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "bun run lint:fix",
      "bun run format:fix"
    ]
  },
  "imports": {
    "#prismagenerated/*": "./src/shared/generated/*",
    "#shared/*": "./src/shared/*"
  }
}
