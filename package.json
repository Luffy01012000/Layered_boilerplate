{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "build": "cross-env NODE_ENV=production tsc",
    "typecheck": "tsc --noEmit --watch",
    "dev": "cross-env NODE_ENV=development tsx watch src/server.ts",
    "lint": "tsc --noEmit && eslint \"src/**/*.ts*\"",
    "migration:create": "cross-env NODE_ENV=development tsx \"./scripts/migrate.ts\" create ",
    "migration:up": "cross-env NODE_ENV=development tsx \"./scripts/migrate.ts\" up ",
    "migration:down": "cross-env NODE_ENV=development tsx \"./scripts/migrate.ts\" down ",
    "db:seed:create": "cross-env NODE_ENV=development tsx \"./scripts/seed.ts\" create",
    "db:seed": "cross-env NODE_ENV=development tsx \"./scripts/seed.ts\" up",
    "db:seed:down": "cross-env NODE_ENV=development tsx \"./scripts/seed.ts\" down",
    "lint:fix": "tsc --noEmit && eslint \"src/**/*.ts*\" --fix",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^9",
    "@faker-js/faker": "^10.5.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "dependencies": {
    "colorette": "^2.0.20",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "dotenv-flow": "^4.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "ms": "^2.1.3",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "umzug": "^3.8.3",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "bun run lint:fix",
      "bun run format:fix"
    ]
  }
}
